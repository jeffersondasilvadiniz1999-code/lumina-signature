DATABASE_URL=
LUMINA_SECRET=
PUBLIC_BASE_URL=https://lumina-signature.onrender.com
# Optional. PostgreSQL remains a persistent image store if Cloudinary is not configured.
CLOUDINARY_URL=
# Render Free blocks SMTP ports. Use verified HTTPS transactional email.
BREVO_API_KEY=
# SMTP below is optional for local/compatible hosts. Do not commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# For a fresh empty database only, use manage.py create-admin explicitly.
ADMIN_INITIAL_EMAIL=admin@lumina.local
ADMIN_INITIAL_PASSWORD=
